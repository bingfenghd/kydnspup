{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "resolveJsonModule": true, "strict": true, "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
