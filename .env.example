# 本机监听；公网访问应通过同机 HTTPS 反向代理。
KY_HOST=127.0.0.1
KY_PORT=4178
# 本地源码构建的镜像标签；升级时使用新标签并保留旧镜像。
KY_IMAGE=kydnspup:0.1.0-local
# 改为本站实际 Origin，不含路径或尾部斜线。
KY_PUBLIC_ORIGIN=https://example.com
# 首次创建管理员的安装凭证，防止公网访客抢先初始化；不是登录密码或节点 API 密钥。
# 运行 ./scripts/deployment.sh init 自动生成到私密 .env；复制等号后的值填写 /admin 的「初始化令牌」。
# 创建管理员后只用自设密码登录；仍保留此变量，Compose 启动校验需要它。详见 docs/deployment.md。
KY_SETUP_TOKEN=
# SQLite 数据库及加密密钥目录；不要公开或提交。
KY_DATA_DIR=var
# 仅信任来自本机回环代理且由代理覆盖的 X-Real-IP。
KY_TRUST_LOCAL_PROXY=1
